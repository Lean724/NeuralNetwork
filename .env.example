# Puerto web expuesto para acceder desde el navegador
NN_PORT=8080

# Puerto interno en network_mode: host (excluido automáticamente de la captura BPF)
NN_INTERNAL_PORT=18080

# Interfaz de captura inicial: auto | eth0 | wlan0 | any
NN_INTERFACE=auto

# Modo inicial de captura: live | simulation
NN_DEFAULT_MODE=live

# Segundos antes de remover neuronas efímeras inactivas no fijadas
NN_NODE_TTL_SEC=120

# Activar modo promiscuo en libpcap
NN_PROMISCUOUS=true
